# Minimal Ansible control node.
ansible-core==2.22.0
# Connection/transport helpers commonly needed even on core.
cryptography
jmespath
# Keep setuptools current & hash-pinned: Debian's venv ships an old, CVE-affected
# setuptools (66.x); pinning it here upgrades it consistently across all distros.
setuptools
# Hash-pin pip itself: the builder installs it via --require-hashes instead of an
# unhashed `pip install --upgrade pip` from PyPI.
pip
